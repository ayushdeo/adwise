# Derived / large artifacts (regenerable)
derisk/cache/*
!derisk/cache/.gitkeep
!derisk/cache/bids.json          # deterministic economics — keep for cross-machine reproducibility
derisk/results/*
!derisk/results/.gitkeep

# Conversation data: WildChat-1M / LMSYS-Chat-1M are research-license / HF-gated.
# Do NOT commit raw conversations. Regenerate with subsample.py on each machine.
derisk/data/*
!derisk/data/.gitkeep

# CompanionGuard run artifacts (regenerable; may contain elicited transcripts)
companionguard/cache/*
!companionguard/cache/.gitkeep
companionguard/results/*
!companionguard/results/.gitkeep
companionguard/data/*
!companionguard/data/.gitkeep

